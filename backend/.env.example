############################################################################
#  PixGram — BACKEND environment template
#  Copy to `.env`  ->  `cp .env.example .env`  and fill every value.
#  NEVER commit the real .env  (it is git-ignored).
#  NO secret may ever exist inside the source code. This file is the ONLY
#  place where credentials, tokens and URLs are allowed to live.
############################################################################

# --------------------------------------------------------------------------
# 1. RUNTIME
# --------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins (the Vercel frontend).
# Local dev origins are whitelisted automatically when NODE_ENV !== production.
CORS_ORIGINS=https://ins-clone-v1.vercel.app

# --------------------------------------------------------------------------
# 2. PUBLIC URLs  (consumed by config/urls.js — never hardcode URLs in code)
#    PUBLIC_BASE_URL is the Cloudflare Tunnel hostname of THIS backend.
#    FRONTEND_BASE_URL is the Vercel deployment (used for Telegram deep links).
# --------------------------------------------------------------------------
PUBLIC_BASE_URL=https://api.d4mdev.click
FRONTEND_BASE_URL=https://ins-clone-v1.vercel.app

# --------------------------------------------------------------------------
# 3. DATABASE — MariaDB on Termux
#    `MARIADB_DATADIR` / `MARIADB_SOCKET` default to the Termux prefix when
#    left empty. Set them explicitly if you installed MariaDB elsewhere.
# --------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pixgram
DB_USER=pixgram
DB_PASSWORD=change_me_db_password
DB_DIALECT=mariadb
DB_LOGGING=false
DB_POOL_MAX=10
# Unix socket (Termux). Used by the start/init scripts. Optional for Node
# (Node connects over TCP by default).
MARIADB_SOCKET=
MARIADB_DATADIR=

# --------------------------------------------------------------------------
# 4. AUTH (user facing)
# --------------------------------------------------------------------------
JWT_SECRET=replace_with_64_random_hex_chars
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10
# When true, the first registered user automatically becomes an admin.
FIRST_USER_IS_ADMIN=true

# --------------------------------------------------------------------------
# 4b. CỔNG ĐĂNG KÝ — ứng dụng công khai hay chỉ vào bằng lời mời
#     true  = ai cũng tự tạo được tài khoản (mặc định, đúng với app chia sẻ ảnh)
#     false = quay lại chế độ riêng tư: BẮT BUỘC có link mời mới đăng ký được
#     (đổi giá trị này là xong, không cần sửa mã nguồn)
# --------------------------------------------------------------------------
PUBLIC_REGISTRATION=true

# --------------------------------------------------------------------------
# 4c. CHAT 1-1 (tin nhắn) (kiểu Instagram Direct)
# --------------------------------------------------------------------------
# Độ dài tối đa một tin nhắn chữ.
CHAT_MAX_MESSAGE_LENGTH=1000
# Số tin mỗi lần tải; cuộn lên sẽ tải thêm tin cũ hơn theo từng trang này.
CHAT_PAGE_SIZE=30
# Ảnh/video gửi trong tin nhắn: nhỏ hơn ảnh feed để gửi nhanh qua 4G.
CHAT_MAX_ATTACHMENT_MB=10
# true = người chưa từng trò chuyện mà nhắn trước thì tin nằm ở "Tin nhắn chờ",
#        người nhận bấm Đồng ý mới vào hộp thư chính (chống spam).
CHAT_MESSAGE_REQUESTS=true
# Kênh realtime dùng SSE. Nếu mạng/nhà cung cấp chặn kết nối dài, giao diện tự
# chuyển sang hỏi định kỳ theo nhịp dưới đây (ms).
CHAT_POLL_INTERVAL_MS=5000
# Nhịp "tim đập" giữ kết nối SSE sống qua Cloudflare Tunnel (ms).
CHAT_SSE_HEARTBEAT_MS=25000
# Số tin tối đa một người được gửi trong mỗi cửa sổ RATE_LIMIT_WINDOW_MINUTES.
CHAT_RATE_LIMIT_MAX=120

# --------------------------------------------------------------------------
# 5. ADMINJS DASHBOARD  (/admin)
#    Prefer ADMIN_PASSWORD_HASH (generate with `npm run admin:passwd`).
#    ADMIN_PASSWORD is only a fallback for quick local setups.
# --------------------------------------------------------------------------
ADMIN_EMAIL=admin@d4mdev.click
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change_me_admin_password
# Ngôn ngữ giao diện trang quản trị: vi (mặc định, bộ dịch tự viết) · en · zh-CN (có sẵn)
ADMIN_LOCALE=vi
ADMIN_AVAILABLE_LOCALES=vi,en,zh-CN
ADMIN_COOKIE_NAME=pixgram.admin
ADMIN_SESSION_SECRET=replace_with_another_64_random_hex_chars
ADMIN_SESSION_MAX_AGE_MS=86400000

# --------------------------------------------------------------------------
# 6. UPLOADS
# --------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
# Image URLs are signed-free but not enumerable: random 32-char filenames.
IMAGE_FILENAME_BYTES=16

# --- Reels (video). KHÔNG cần ffmpeg: server tự đọc thời lượng từ atom mvhd ---
MAX_VIDEO_SIZE_MB=60
MAX_VIDEO_DURATION_SECONDS=60
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime

# --- Nhạc nền cho Reels: phát đồng bộ ở client, KHÔNG mux vào video ---
MAX_AUDIO_SIZE_MB=10
ALLOWED_AUDIO_MIME_TYPES=audio/mpeg,audio/mp4,audio/aac,audio/ogg,audio/wav

# --- Giám sát dung lượng: điện thoại đầy đĩa là máy chủ sập ---------------
# Tổng dung lượng uploads (MB) từ mức này trở lên thì nhắc qua Telegram
# (tối đa 1 lần / 6 giờ). Đặt 0 để tắt.
STORAGE_WARN_TOTAL_MB=2000
# Còn ít hơn % dung lượng đĩa trống thì cảnh báo mức "nguy hiểm". 0 = tắt.
DISK_FREE_WARN_PERCENT=10

# --------------------------------------------------------------------------
# 7. SECURITY / RATE LIMIT
# --------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=30

# --------------------------------------------------------------------------
# 8. TELEGRAM BOT  (runs inside server.js, same process)
#    Create the bot with @BotFather, then send /start to your own bot and
#    read the printed chat-id from the backend log, or use the /id command.
# --------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_ENABLED=true
TELEGRAM_SEND_PHOTO=true
# Ngôn ngữ mặc định của thông báo Telegram: vi (chính) | en | zh (phụ).
# Admin đổi ngay trong chat bằng lệnh: /lang en
TELEGRAM_DEFAULT_LOCALE=vi

# --------------------------------------------------------------------------
# 10. NGÔN NGỮ NGƯỜI DÙNG (i18n)
#    Giao diện React mặc định là tiếng Việt; tiếng Anh và tiếng Trung là phụ.
#    Backend đọc Accept-Language do frontend gửi, lưu vào User.locale và dùng
#    lại cho thông báo Telegram của từng thành viên.
# --------------------------------------------------------------------------
DEFAULT_LOCALE=vi
SUPPORTED_LOCALES=vi,en,zh

# --------------------------------------------------------------------------
# 10. CLOUDFLARE TUNNEL
#    `cloudflared tunnel run` reads ~/.cloudflared/config.yml, but we keep the
#    name here too so the 1-click script can run it explicitly.
# --------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_NAME=pixgram-api
CLOUDFLARE_TUNNEL_CONFIG=~/.cloudflared/config.yml
CLOUDFLARE_HOSTNAME=api.d4mdev.click

# Tunnel quản lý qua dashboard (Zero Trust → Networks → Tunnels → connector token).
# Có token thì KHÔNG cần config.yml — script sẽ tự chọn cách chạy phù hợp.
CLOUDFLARE_TUNNEL_TOKEN=

# --------------------------------------------------------------------------
# 13. EMAIL THÔNG BÁO (tuỳ chọn) — Gmail + mật khẩu ứng dụng 16 ký tự
#     ⚠️ Đây là khoá CHỈ DÙNG Ở SERVER. Tuyệt đối không đặt trong biến VITE_*
#     của Vercel, không nhúng vào mã React — ai có khoá này là gửi được email
#     thay bạn.
# --------------------------------------------------------------------------
EMAIL_ENABLED=false
SENDER_EMAIL=
SENDER_PASSWORD=

# Người nhận thông báo "có ảnh mới". Có thể là chính Gmail của bạn.
NOTIFY_EMAIL=
GCAL_EMAIL=

# --- Chi tiết máy chủ SMTP (mặc định đúng cho Gmail, chỉ cần đổi nếu dùng nơi khác)
MAIL_FROM_NAME=PixGram
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true = kết nối mã hoá ngay từ đầu (cổng 465). false = STARTTLS (cổng 587).
SMTP_SECURE=false

# Gửi email cho quản trị viên mỗi khi có ảnh/video mới? (true/false)
EMAIL_NOTIFY_NEW_PHOTO=true

# --- Hạn dùng của các liên kết một-lần trong email --------------------------
# Link "đặt lại mật khẩu" sống bao nhiêu phút (mặc định 30).
RESET_TOKEN_TTL_MINUTES=30
# Link "mời thành viên" sống bao nhiêu ngày (mặc định 7).
INVITE_TTL_DAYS=7

# Kiểm tra cấu hình email bất cứ lúc nào (không cần khởi động server):
#   cd backend && npm run mail:test          → kiểm tra SMTP + gửi 1 email thử
#   cd backend && npm run mail:test -- --dry → chỉ kiểm tra đăng nhập SMTP

# --------------------------------------------------------------------------
# 14. TRỢ LÝ AI (tuỳ chọn) — Gemini API key (Google AI Studio, dạng AIza…)
#     Cũng chỉ chạy ở server; không bao giờ lộ ra trình duyệt.
# --------------------------------------------------------------------------
AI_ENABLED=false
GEMINI_API_KEY=
