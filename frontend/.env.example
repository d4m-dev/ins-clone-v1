# ---------------------------------------------------------------------------
# FamilyGram frontend — Vite environment template
# Copy to `.env.local` for development, and define the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# Public origin of this web app (used for share links / OG tags).
VITE_APP_ORIGIN=https://family.d4mdev.click

# Origin of the backend exposed by the Cloudflare Tunnel.
# Leave EMPTY to use same-origin relative URLs (recommended: the Vite dev
# server proxies /api and /uploads to the backend, so nothing is hardcoded).
VITE_API_ORIGIN=https://api.d4mdev.click

# Optional overrides (defaults shown)
VITE_API_PREFIX=api
VITE_UPLOADS_PREFIX=uploads
VITE_ADMIN_URL=https://api.d4mdev.click/admin

# Only needed when you run `npm run dev` against a backend on another machine
# (the proxy target used by vite.config.js — never used by the browser).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:4000

# ---------------------------------------------------------------------------
# NGÔN NGỮ / i18n — Tiếng Việt là chính, English + 中文 là phụ
# Người dùng đổi ngay trên UI (sidebar / thanh trên / màn hình đăng nhập);
# lựa chọn được lưu vào localStorage và gửi kèm header Accept-Language.
# ---------------------------------------------------------------------------
VITE_DEFAULT_LOCALE=vi
VITE_SUPPORTED_LOCALES=vi,en,zh
